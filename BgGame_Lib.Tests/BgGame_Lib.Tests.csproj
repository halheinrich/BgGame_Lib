<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / Nullable / ImplicitUsings / TreatWarningsAsErrors are
       repo-wide policy in Directory.Build.props. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- No shipping surface, so no XML docs: undocumented test members must not
         warn (and, under TreatWarningsAsErrors, fail the build). Warnings stay
         errors; only the doc-file requirement is lifted. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BgGame_Lib\BgGame_Lib.csproj" />
  </ItemGroup>

  <!-- What consumers' tests share, from the data layer: the record builders
       (TestRecords), the one way a test builds a decision record, so no test
       here restates the records' construction. -->
  <ItemGroup>
    <ProjectReference Include="..\..\BgDataTypes_Lib\BgDataTypes_Lib.TestSupport\BgDataTypes_Lib.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
